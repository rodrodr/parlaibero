{
  "name": "parlaibero-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio de presentación de ParlaIbero. Los datos los escribe diaries/scripts/exportar_sitio.py; los textos salen de docs/0*_COPY_*.md.",
  "scripts": {
    "i18n": "python3 scripts/copy2i18n.py es && python3 scripts/copy2i18n.py en && python3 scripts/copy2i18n.py pt",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-i18n.mjs",
    "audit": "node scripts/audit-cifras.mjs && node scripts/check-funding.mjs",
    "og": "node scripts/og.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
