---
/**
 * BORRADOR (rama `portada-rotativa`). La apertura de Inicio, rotando de pregunta en cada visita.
 * SOLO cambia el primer bloque —la pregunta y su figura—; el resto de Inicio no se toca.
 *
 * Cómo rota, y por qué así:
 *  · La primera apertura (la aprobada, la de la voz de las diputadas) se pinta NORMAL. Las demás viajan dentro de
 *    un `<template>`, cuyo contenido no está en el documento: así la página sigue teniendo UN solo `h1`, el lector
 *    de pantalla no oye siete preguntas y nada se carga dos veces.
 *  · Sin JavaScript se ve la primera, que es exactamente la portada de hoy. Con JavaScript, un script síncrono
 *    —colocado justo detrás, de modo que se ejecuta antes de pintar— elige una al azar y la sustituye.
 *  · El botón «Otra pregunta» permite recorrerlas a mano, que es lo que hace falta para compararlas.
 */
import Apertura from './Apertura.astro';
import FigTermino from '../FigTermino.astro';
import { resuelve } from '../../lib/cifras';
import { recurso } from '../../lib/rutas';
import { APERTURAS, OTRA, LEYENDA, type Lang3 } from '../../config/portada';
import type { Lang } from '../../lib/idiomas';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = lang as Lang3;

/**
 * `{corpus}` es la única cifra de estos títulos, y se resuelve como cualquier otra del sitio (envuelta y auditable).
 * A principio de frase se escribe con mayúscula, como hace `t()` con los números en letra del copy.
 */
const conCifras = (s: string) => {
  const html = resuelve('corpus.n|letra', lang);
  const inicial = s.startsWith('{corpus}') ? html.replace(/(>|^)(\p{L})/u, (_x, a, b) => a + b.toUpperCase()) : html;
  return s.replace('{corpus}', inicial);
};
const hitosDe = (a: (typeof APERTURAS)[number]) =>
  Object.fromEntries(Object.entries(a.hitos ?? {}).map(([iso, h]) => [iso, { ano: h.ano, texto: h[L] }]));
const primera = APERTURAS[0];
// Las demás viajan en un `<template>`: la de la voz también, porque ya no es siempre la primera.
const alternativas = APERTURAS.map((a, i) => ({ ...a, i })).filter((_, i) => i > 0);
---
<div class="rotativa" data-rotativa>
  {/* La PRIMERA de la lista abre la página: es lo que ve quien llega sin JavaScript y quien llega por primera vez. */}
  <div data-actual>
    {primera.tipo === 'voz' ? <Apertura lang={lang} /> : <Fragment set:html={''} />}
    {primera.tipo === 'termino' && (
      <section class="apertura" aria-labelledby="pregunta-0">
        <div class="contenedor"><h1 id="pregunta-0" class="pregunta">{primera.textos![L].pregunta}</h1></div>
        <div class="contenedor figura">
          <FigTermino lang={lang} familia={primera.familia!} id={`termino-${primera.familia}`} leyenda={conCifras(LEYENDA[L])} hitos={hitosDe(primera)}>
            <Fragment slot="titulo" set:html={conCifras(primera.textos![L].titulo)} />
            <Fragment slot="salvedad">{primera.textos![L].salvedad}</Fragment>
          </FigTermino>
        </div>
        <div class="contenedor reja lectura"><p class="lede ejemplos">{primera.textos![L].hallazgo}</p></div>
      </section>
    )}
  </div>

  {alternativas.map((a) => (
    <template data-giro={a.i}>
      {a.tipo === 'voz' ? <Apertura lang={lang} /> : (
      <section class="apertura" aria-labelledby={`pregunta-${a.i}`}>
        <div class="contenedor">
          <h1 id={`pregunta-${a.i}`} class="pregunta">{a.textos![L].pregunta}</h1>
        </div>
        <div class="contenedor figura">
          <FigTermino lang={lang} familia={a.familia!} id={`termino-${a.familia}`} leyenda={conCifras(LEYENDA[L])} hitos={hitosDe(a)}>
            <Fragment slot="titulo" set:html={conCifras(a.textos![L].titulo)} />
            <Fragment slot="salvedad">{a.textos![L].salvedad}</Fragment>
          </FigTermino>
        </div>
        <div class="contenedor reja lectura">
          <p class="lede ejemplos">{a.textos![L].hallazgo}</p>
        </div>
      </section>
      )}
    </template>
  ))}

  <p class="control-rotativa contenedor no-imprimir">
    <button type="button" data-otra>{OTRA[L]}</button>
    <span class="borrador">borrador</span>
  </p>
</div>

<script is:inline>
  (function () {
    var caja = document.currentScript.closest('[data-rotativa]') || document.querySelector('[data-rotativa]');
    if (!caja) return;
    var hueco = caja.querySelector('[data-actual]');
    var giros = [].slice.call(caja.querySelectorAll('template[data-giro]'));
    if (!hueco || !giros.length) return;
    // La primera no está en un `<template>`: se guarda tal cual para poder volver a ella.
    var primera = hueco.firstElementChild ? hueco.firstElementChild.cloneNode(true) : null;
    var total = giros.length + 1;
    var actual = 0;

    function pon(i) {
      if (i === actual) return;
      var nodo = i === 0 ? (primera ? primera.cloneNode(true) : null) : giros[i - 1].content.cloneNode(true);
      if (!nodo) return;
      hueco.replaceChildren(nodo);
      actual = i;
    }
    // La primera visita se abre con la primera de la lista; a partir de ahí, rota al azar. Si el navegador no
    // deja recordarlo (ventana privada, permisos), se queda en la primera: nunca falla hacia algo peor.
    var repite = false;
    try { repite = localStorage.getItem('parlaibero.portada') === '1'; localStorage.setItem('parlaibero.portada', '1'); } catch (e) {}
    if (repite) pon(Math.floor(Math.random() * total));

    var boton = caja.querySelector('[data-otra]');
    if (boton) boton.addEventListener('click', function () {
      pon((actual + 1) % total);
      var h = hueco.querySelector('h1');
      if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
    });
  })();
</script>

<style>
  .control-rotativa { display: flex; align-items: baseline; gap: .8rem; margin: 1.6rem auto 0; }
  .control-rotativa button {
    font: 700 var(--fs-small)/1.2 var(--display); font-stretch: 92%; color: var(--accent);
    background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 .1em; cursor: pointer;
  }
  .control-rotativa .borrador {
    font: 500 .68rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--mute);
    border: 1px solid var(--hair); border-radius: var(--radio); padding: .25em .5em;
  }
</style>
