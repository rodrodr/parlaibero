---
/**
 * BORRADOR · herramienta de TRIAJE (rama `portada-rotativa`). NO es una página del sitio: no se enlaza, no se
 * traduce y desaparece cuando el investigador elija los términos. Pinta las 41 familias medidas, una debajo de
 * otra y con la misma figura que usaría la portada, para poder compararlas de un vistazo.
 * Cada figura lleva su media, cuánto separa a unas cámaras de otras, y las raíces con que se contó.
 */
import Base from '../layouts/Base.astro';
import FigTermino from '../components/FigTermino.astro';
import TERMINOS from '../data/terminos.json';
import { PAISES } from '../lib/cifras';
import { PAGINAS } from '../lib/rutas';

const T = TERMINOS as unknown as {
  min_palabras: number;
  familias: Record<string, string>;
  paises: Record<string, { anual: Record<string, Record<string, number>> }>;
};

/** Cuánto separa una familia: la cámara que más la dice frente a la cámara mediana. */
function separa(fam: string): number {
  const por = PAISES.map((p) => {
    const a = Object.values(T.paises[p.iso]?.anual ?? {});
    const n = a.reduce((s, x) => s + (x[fam] ?? 0), 0);
    const den = a.reduce((s, x) => s + x.palabras, 0);
    return den > 0 ? (n * 1e6) / den : 0;
  }).sort((x, y) => x - y);
  return por[por.length - 1] / Math.max(0.5, por[Math.floor(por.length / 2)]);
}

const familias = Object.keys(T.familias)
  .map((f) => ({ f, sep: separa(f), raices: T.familias[f] }))
  .sort((a, b) => b.sep - a.sep);
---
<Base lang="es" ruta={PAGINAS.inicio} titulo="Catálogo de términos · borrador" descripcion="Herramienta de triaje: las familias medidas, con la figura de la portada.">
  <div class="contenedor cat-intro" data-audit-exento="borrador de triaje: no es una página del sitio y sus cifras son técnicas">
    <h1>Catálogo de términos</h1>
    <p class="lede">Las {familias.length} familias medidas, ordenadas por cuánto separan a unas cámaras de otras. Es una herramienta de triaje, no una página del sitio.</p>
  </div>
  {familias.map(({ f, sep, raices }) => (
    <section class="contenedor cat-bloque" id={`cat-${f}`} data-audit-exento="borrador de triaje">
      <p class="cat-meta mono">{f} · separa {sep.toFixed(1)}× · {raices}</p>
      <FigTermino lang="es" familia={f} id={`cat-fig-${f}`} leyenda={'Una cámara, año a año, todas a la misma escala: de cero a {techo} por millón. La raya de puntos es la media de las dieciséis: {media}.'}>
        <Fragment slot="titulo">{f}</Fragment>
        <Fragment slot="salvedad">Veces por millón de palabras dichas. Un año con poco material no entra.</Fragment>
      </FigTermino>
    </section>
  ))}
</Base>

<style>
  .cat-intro { padding-block: 3rem 1rem; }
  .cat-bloque { padding-block: 2.5rem; border-top: 1px solid var(--ink); }
  .cat-meta { margin: 0 0 1rem; font-size: .72rem; color: var(--mute); overflow-wrap: anywhere; }
</style>
