---
/** Raíz del sitio: selector de idioma estático. Sin JS funciona como lista de enlaces; con JS, lleva a la lengua del navegador. */
import '../styles/base.css';
import '@fontsource-variable/archivo/wdth.css';
import FundingNotice from '../components/FundingNotice.astro';
import { LANGS, HTML_LANG } from '../lib/idiomas';
import { plano, rotulo, t } from '../lib/i18n';
import { url, recurso } from '../lib/rutas';
// La mención de la AEI va en TODAS las páginas, también en esta (check-funding.mjs no exime ninguna).
// El aviso del explorador va bajo el selector, en las lenguas a las que afecta (copy §1.6, nota de diseño).
const AVISOS = LANGS.filter((l) => l !== 'es');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plano('es', 'comun.idioma.raiz.titulo')}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(url('es'), Astro.site).href} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(url(l), Astro.site).href} />)}
    <link rel="icon" type="image/svg+xml" href={recurso('favicon.svg')} />
    <script is:inline define:vars={{ destinos: Object.fromEntries(LANGS.map((l) => [l, url(l)])) }}>
      const pref = (navigator.languages || [navigator.language || 'es']).map((x) => x.slice(0, 2).toLowerCase());
      const l = pref.find((x) => destinos[x]) || 'es';
      location.replace(destinos[l]);
    </script>
  </head>
  <body>
    <main class="contenedor" style="padding-block: 18vh">
      <h1 style="font-size: var(--fs-h2)">{plano('es', 'comun.cabecera.nombre')}</h1>
      <ul style="list-style:none;padding:0;margin-top:2rem;display:flex;gap:1.5rem;flex-wrap:wrap">
        {LANGS.map((l) => <li><a class="boton secundario" href={url(l)} lang={HTML_LANG[l]} hreflang={HTML_LANG[l]} set:html={rotulo(l, `comun.idioma.${l}`)} /></li>)}
      </ul>
      {AVISOS.map((l) => <p class="nota" lang={HTML_LANG[l]} style="margin-top:1.5rem" set:html={t(l, `comun.idioma.aviso.${l}`)} />)}
    </main>
    <footer class="contenedor" style="padding-block:2rem 3rem;border-top:1px solid var(--hair)">
      <FundingNotice lang="es" variante="completa" />
    </footer>
  </body>
</html>
